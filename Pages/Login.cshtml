@page
@model TennisIntelligence.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h4">Tennis Intelligence</h2>
                <p class="text-muted">Enter the private application password.</p>
                <form method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           autocomplete="current-password"
                           autofocus />
                    <button type="submit" class="btn btn-success w-100 mt-3">Sign in</button>
                </form>
            </div>
        </div>
    </div>
</div>
