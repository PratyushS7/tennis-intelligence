@page
@model TennisIntelligence.Pages.InsightsModel
@using TennisIntelligence.Services
@{
    ViewData["Title"] = "Insights";

    string RatingEmoji(int? rating) => rating switch
    {
        1 => "😫",
        2 => "😕",
        3 => "😐",
        4 => "🙂",
        5 => "🔥",
        _ => "—"
    };

    (string Css, string Label) CharacterBadge(SessionCharacter character) => character switch
    {
        SessionCharacter.Hard => ("bg-danger", "Hard"),
        SessionCharacter.Moderate => ("bg-warning text-dark", "Moderate"),
        SessionCharacter.Light => ("bg-info text-dark", "Light"),
        _ => ("bg-secondary", "—")
    };
}

<h2>📊 Insights Dashboard</h2>

@if (Model.TrainingLoad.HasData)
{
    var load = Model.TrainingLoad;
    var tennis = load.TennisWorkouts;
    var latestRecovery = load.RecoveryTrend.LastOrDefault();

    <h4 class="mt-4">⌚ Training load</h4>
    <p class="text-muted small mb-3">
        Measured from your watch's heart-rate series. Zones are a share of your highest recorded
        heart rate (@load.ObservedMaxHeartRate bpm). Nothing here needs logging by hand.
    </p>

    <div class="row g-3">
        <div class="col-6 col-md-3">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <h3 class="text-success">@tennis.Count</h3>
                    <small class="text-muted">Tennis sessions analysed</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <h3 class="text-danger">@load.TennisZones.HardPct.ToString("F0")%</h3>
                    <small class="text-muted">Time at threshold or above</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <h3 class="text-primary">@(latestRecovery?.Analysis.HeartRateRecovery60?.ToString() ?? "—")</h3>
                    <small class="text-muted">Recovery, last hard session (bpm)</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <h3 class="text-secondary">@load.TennisHardSessions / @load.TennisModerateSessions / @load.TennisLightSessions</h3>
                    <small class="text-muted">Hard / moderate / light</small>
                </div>
            </div>
        </div>
    </div>

    @if (load.TennisZones.HardPct > 0 || load.TennisZones.Zone1Pct > 0)
    {
        <div class="card shadow-sm mt-3">
            <div class="card-body">
                <h6 class="card-title">Where your tennis time actually goes</h6>
                <div class="progress" style="height: 26px;" role="img"
                     aria-label="Heart-rate zone distribution across tennis sessions">
                    <div class="progress-bar bg-secondary" style="width:@load.TennisZones.Zone1Pct.ToString("F1")%">Z1</div>
                    <div class="progress-bar bg-info text-dark" style="width:@load.TennisZones.Zone2Pct.ToString("F1")%">Z2</div>
                    <div class="progress-bar bg-success" style="width:@load.TennisZones.Zone3Pct.ToString("F1")%">Z3</div>
                    <div class="progress-bar bg-warning text-dark" style="width:@load.TennisZones.Zone4Pct.ToString("F1")%">Z4</div>
                    <div class="progress-bar bg-danger" style="width:@load.TennisZones.Zone5Pct.ToString("F1")%">Z5</div>
                </div>
                <small class="text-muted">
                    Z1 easy · Z2 aerobic · Z3 tempo · Z4 threshold · Z5 maximal — weighted by session length.
                </small>
            </div>
        </div>
    }

    @if (load.RecoveryTrend.Count >= 2)
    {
        var best = load.RecoveryTrend.Max(w => w.Analysis.HeartRateRecovery60 ?? 0);
        <div class="card shadow-sm mt-3">
            <div class="card-body">
                <h6 class="card-title">Recovery trend</h6>
                <p class="text-muted small mb-3">
                    Beats shed in the 60s after a threshold effort, across your harder tennis sessions.
                    Rising over time means your conditioning is improving. Easy hits are left out because
                    they never push hard enough to compare.
                </p>
                @foreach (var workout in load.RecoveryTrend)
                {
                    var recovery = workout.Analysis.HeartRateRecovery60 ?? 0;
                    var width = best > 0 ? 100.0 * recovery / best : 0;
                    <div class="d-flex align-items-center mb-1">
                        <span class="text-muted small" style="width: 92px;">@workout.StartedAt.ToLocalTime().ToString("ddd d MMM")</span>
                        <div class="progress flex-grow-1" style="height: 14px;">
                            <div class="progress-bar bg-primary" style="width:@width.ToString("F1")%"></div>
                        </div>
                        <span class="small ms-2" style="width: 56px;">@recovery bpm</span>
                    </div>
                }
            </div>
        </div>
    }

    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <h6 class="card-title">Session by session</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Activity</th>
                            <th class="text-end">Min</th>
                            <th>Intensity</th>
                            <th style="min-width:140px;">Zones</th>
                            <th class="text-end">Hard</th>
                            <th class="text-end">Recovery</th>
                            <th class="text-end">Drift</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var workout in load.Workouts.Where(w => w.Analysis.HasSeries))
                    {
                        var badge = CharacterBadge(workout.Analysis.Character);
                        var zones = workout.Analysis.Zones;
                        <tr>
                            <td>@workout.StartedAt.ToLocalTime().ToString("ddd d MMM")</td>
                            <td>@workout.ActivityType</td>
                            <td class="text-end">@workout.DurationMinutes</td>
                            <td><span class="badge @badge.Css">@badge.Label</span></td>
                            <td>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar bg-secondary" style="width:@zones.Zone1Pct.ToString("F1")%"></div>
                                    <div class="progress-bar bg-info" style="width:@zones.Zone2Pct.ToString("F1")%"></div>
                                    <div class="progress-bar bg-success" style="width:@zones.Zone3Pct.ToString("F1")%"></div>
                                    <div class="progress-bar bg-warning" style="width:@zones.Zone4Pct.ToString("F1")%"></div>
                                    <div class="progress-bar bg-danger" style="width:@zones.Zone5Pct.ToString("F1")%"></div>
                                </div>
                            </td>
                            <td class="text-end">@zones.HardPct.ToString("F0")%</td>
                            <td class="text-end">
                                @if (workout.Analysis.HeartRateRecovery60 is int recovery)
                                {
                                    <span title="@workout.Analysis.RecoveryWindowCount recovery windows">@recovery bpm</span>
                                }
                                else
                                {
                                    <span class="text-muted" title="Never reached threshold, so there was no effort to recover from">—</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (workout.Analysis.DriftBpm is int drift)
                                {
                                    <span class="@(drift > 5 ? "text-danger" : drift < -5 ? "text-success" : "text-muted")">
                                        @(drift > 0 ? "+" : string.Empty)@drift
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <small class="text-muted d-block mt-2">
                <strong>Recovery</strong> is beats shed in the 60s after a threshold effort — higher is fitter.
                <strong>Drift</strong> compares the final third to the middle third; positive means you faded.
            </small>
        </div>
    </div>
}

<h4 class="mt-4">📝 Session log</h4>

@if (Model.TotalSessions == 0)
{
    <div class="alert alert-info">
        Nothing logged by hand yet. The training load above comes straight from your watch —
        <a asp-page="/LogSession">log a session</a> to add how it actually felt.
    </div>
}
else
{
    <!-- Summary Cards -->
    <div class="row g-3 mt-2">
        <div class="col-6 col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h3 class="text-success">@Model.TotalSessions</h3>
                    <small class="text-muted">Total Sessions</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h3 class="text-primary">@Model.AverageEnergy.ToString("F1")</h3>
                    <small class="text-muted">Avg Energy</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h3 class="text-success">@Model.CurrentStreak</h3>
                    <small class="text-muted">Current Streak</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h3 class="text-primary">@Model.LongestStreak</h3>
                    <small class="text-muted">Longest Streak</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Collapsible Body Data cards -->
    <div class="mt-3">
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#bodyDataSection">
            🩺 Body Data
        </button>
        <div class="collapse mt-2" id="bodyDataSection">
            <div class="row g-3">
                <div class="col-6">
                    <div class="card text-center shadow-sm">
                        <div class="card-body">
                            <h3 class="text-warning">@Model.AverageElbowPain.ToString("F1")</h3>
                            <small class="text-muted">Avg Elbow Pain</small>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card text-center shadow-sm">
                        <div class="card-body">
                            <h3 class="text-danger">@Model.AverageShoulderTightness.ToString("F1")</h3>
                            <small class="text-muted">Avg Shoulder</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Focus Achievement + Time on Court -->
    <div class="row g-3 mt-2">
        <div class="col-12 col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>🎯 Focus Achievement Rate</h5>
                    @if (Model.FocusTotal > 0)
                    {
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar bg-success" style="width: @Model.FocusAchievedPct%">
                                @Model.FocusAchievedPct% achieved
                            </div>
                        </div>
                        <small class="text-muted">@Model.FocusAchievedCount / @Model.FocusTotal sessions with focus</small>
                    }
                    else
                    {
                        <p class="text-muted">No focus data recorded yet</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>⏱️ Total Time on Court</h5>
                    <h3>@Model.TotalMinutes min</h3>
                    <small class="text-muted">~@((Model.TotalMinutes / 60.0).ToString("F1")) hours</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Best Sessions -->
    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <h5>⭐ Your Best Sessions</h5>
            @if (Model.BestSessions.Any())
            {
                <p class="text-muted mb-2">@Model.BestSessionCommonFactors</p>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Rating</th>
                                <th>Energy</th>
                                <th>Type</th>
                                <th>Focus</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.BestSessions)
                            {
                                <tr>
                                    <td>@s.Date.ToString("MMM dd")</td>
                                    <td>@RatingEmoji(s.SessionRating)</td>
                                    <td>@s.EnergyLevel/10</td>
                                    <td>@(s.SessionType ?? "—")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(s.FocusArea))
                                        {
                                            @s.FocusArea
                                            @if (s.FocusAchieved == true) { <span>✅</span> }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No sessions rated 4+ yet. Rate your sessions to see patterns!</p>
            }
        </div>
    </div>

    <!-- Breakdown Areas -->
    <div class="row g-3 mt-2">
        <div class="col-12 col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>🔻 Most Common Breakdown Areas</h5>
                    @if (Model.BreakdownAreaCounts.Any())
                    {
                        @foreach (var item in Model.BreakdownAreaCounts)
                        {
                            <div class="mb-2">
                                <div class="d-flex justify-content-between">
                                    <span>@item.Key</span>
                                    <span class="text-muted">@item.Value times (@((100.0 * item.Value / Model.TotalSessions).ToString("F0"))%)</span>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar bg-danger" style="width: @((100.0 * item.Value / Model.TotalSessions).ToString("F0"))%"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No breakdown data</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>❓ Most Common Reasons</h5>
                    @if (Model.BreakdownReasonCounts.Any())
                    {
                        @foreach (var item in Model.BreakdownReasonCounts)
                        {
                            <div class="mb-2">
                                <div class="d-flex justify-content-between">
                                    <span>@item.Key</span>
                                    <span class="text-muted">@item.Value times (@((100.0 * item.Value / Model.TotalSessions).ToString("F0"))%)</span>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar bg-warning" style="width: @((100.0 * item.Value / Model.TotalSessions).ToString("F0"))%"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No reason data</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Weekly Summary -->
    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <h5>📅 Weekly Summary (Last 4 Weeks)</h5>
            @if (Model.WeeklySummaries.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Week Of</th>
                                <th>Sessions</th>
                                <th>Avg Energy</th>
                                <th class="body-data-col" style="display:none;">Avg Elbow</th>
                                <th class="body-data-col" style="display:none;">Avg Shoulder</th>
                                <th>Total Min</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var week in Model.WeeklySummaries)
                            {
                                <tr>
                                    <td>@week.WeekStart.ToString("MMM dd")</td>
                                    <td>@week.Count</td>
                                    <td>@week.AvgEnergy.ToString("F1")</td>
                                    <td class="body-data-col" style="display:none;">@week.AvgElbow.ToString("F1")</td>
                                    <td class="body-data-col" style="display:none;">@week.AvgShoulder.ToString("F1")</td>
                                    <td>@week.TotalMinutes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">Not enough data for weekly summaries</p>
            }
        </div>
    </div>
}

<script>
    // Sync weekly summary body-data columns with the Body Data collapse toggle
    var bodySection = document.getElementById('bodyDataSection');
    if (bodySection) {
        bodySection.addEventListener('shown.bs.collapse', function () {
            document.querySelectorAll('.body-data-col').forEach(function (el) { el.style.display = ''; });
        });
        bodySection.addEventListener('hidden.bs.collapse', function () {
            document.querySelectorAll('.body-data-col').forEach(function (el) { el.style.display = 'none'; });
        });
    }
</script>
