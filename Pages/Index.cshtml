@page
@model IndexModel
@using TennisIntelligence.Models
@{
    ViewData["Title"] = "Home";
    var ratingEmojis = new Dictionary<int, string>
    {
        {1, "😫"}, {2, "😕"}, {3, "😐"}, {4, "🙂"}, {5, "🔥"}
    };
}

<!-- Header -->
<div class="text-center mb-3">
    @if (Model.TotalSessions > 0)
    {
        <p class="lead mb-0 fw-bold">@Model.MotivationalMessage</p>
        @if (!string.IsNullOrEmpty(Model.EnergyTrend))
        {
            <small class="text-muted">@Model.EnergyTrend</small>
        }
    }
    else
    {
        <h1 class="display-5 fw-bold text-success">🎾 Tennis Intelligence</h1>
        <p class="lead text-muted">Your personal tennis companion</p>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.MilestoneMessage != null)
{
    <div class="alert alert-warning alert-dismissible fade show text-center fw-bold" role="alert">
        @Model.MilestoneMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Post-log AI Debrief -->
@if (TempData["ShowDebrief"] != null && Model.TotalSessions > 0)
{
    <div class="card border-info shadow-sm mb-3" id="debriefCard">
        <div class="card-body text-center py-3">
            <div class="spinner-border spinner-border-sm text-info me-2" role="status" id="debriefSpinner"></div>
            <span class="text-muted small" id="debriefLoading">Getting your post-session insight...</span>
            <div id="debriefContent" style="display:none;" class="text-start"></div>
        </div>
    </div>
}

@if (Model.TotalSessions == 0)
{
    <div class="text-center py-5">
        <div style="font-size: 4rem;">🎾</div>
        <h3 class="mt-3">Welcome! Let's track your first session.</h3>
        <p class="text-muted">Log a session to unlock your journal, goals, and AI coaching.</p>
        <a asp-page="/LogSession" class="btn btn-success btn-lg mt-2">📝 Log Your First Session</a>
    </div>
}
else
{
    <!-- Pre-Session Tip -->
    @if (!string.IsNullOrEmpty(Model.PreSessionTip))
    {
        <div class="card border-0 bg-light mb-3">
            <div class="card-body py-2 px-3">
                <span class="small">@Html.Raw(System.Text.RegularExpressions.Regex.Replace(Model.PreSessionTip, @"\*\*(.+?)\*\*", "<strong>$1</strong>"))</span>
            </div>
        </div>
    }

    <!-- Your Journey (Goals as the hero) -->
    @if (Model.ActiveGoalJourneys.Count > 0)
    {
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0">🎯 Your Journey</h6>
                <a asp-page="/Goals" class="text-decoration-none small">Manage →</a>
            </div>
            @foreach (var goal in Model.ActiveGoalJourneys)
            {
                <div class="card shadow-sm mb-2">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <a asp-page="/GoalDetail" asp-route-id="@goal.Id" class="fw-bold text-decoration-none text-dark">@goal.Name</a>
                                <span class="badge bg-secondary bg-opacity-25 text-dark ms-1 small">@goal.Category</span>
                            </div>
                            <span class="small">@goal.Trend</span>
                        </div>
                        <div class="mt-1">
                            @if (goal.Last5Emojis.Count > 0)
                            {
                                <span class="me-2" style="font-size: 1.1rem; letter-spacing: 2px;">
                                    @string.Join(" ", goal.Last5Emojis)
                                </span>
                                <span class="text-muted small">@goal.TotalCheckIns check-ins · @goal.ClickedRate% clicking</span>
                            }
                            else
                            {
                                <span class="text-muted small">No check-ins yet — play a session and check in!</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Quick Log -->
    <div class="card shadow border-success mb-3">
        <div class="card-header bg-success text-white fw-bold">🎾 I Played Today</div>
        <div class="card-body">
            <form method="post" asp-page-handler="QuickLog">
                <!-- Rating -->
                <div class="mb-3">
                    <label class="form-label small fw-bold mb-1">How was it?</label>
                    <div class="d-flex gap-1 justify-content-between">
                        @{
                            var emojis = new[] { "😫", "😕", "😐", "🙂", "🔥" };
                        }
                        @for (int i = 1; i <= 5; i++)
                        {
                            var eid = $"qr_{i}";
                            <input class="btn-check" type="radio" name="QuickRating" value="@i" id="@eid" autocomplete="off" />
                            <label class="btn btn-outline-secondary flex-fill" for="@eid" style="font-size:1.5rem; padding: 0.25rem;">@emojis[i-1]</label>
                        }
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <!-- Duration -->
                    <div class="col-6">
                        <label class="form-label small fw-bold mb-1">Duration</label>
                        <div class="d-flex gap-1">
                            <button type="button" class="btn btn-outline-secondary btn-sm flex-fill quick-dur" data-val="30">30</button>
                            <button type="button" class="btn btn-success btn-sm flex-fill quick-dur active" data-val="60">60</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm flex-fill quick-dur" data-val="90">90</button>
                        </div>
                        <input type="hidden" name="QuickDuration" id="quickDuration" value="60" />
                    </div>
                    <!-- Energy -->
                    <div class="col-6">
                        <label class="form-label small fw-bold mb-1">Energy</label>
                        <div class="d-flex gap-1">
                            <input class="btn-check" type="radio" name="QuickEnergyBefore" value="Fresh" id="qeb_fresh" autocomplete="off" />
                            <label class="btn btn-outline-success btn-sm flex-fill" for="qeb_fresh">🔋</label>
                            <input class="btn-check" type="radio" name="QuickEnergyBefore" value="Normal" id="qeb_normal" autocomplete="off" checked />
                            <label class="btn btn-outline-success btn-sm flex-fill" for="qeb_normal">😐</label>
                            <input class="btn-check" type="radio" name="QuickEnergyBefore" value="Tired" id="qeb_tired" autocomplete="off" />
                            <label class="btn btn-outline-success btn-sm flex-fill" for="qeb_tired">🪫</label>
                        </div>
                    </div>
                </div>

                <!-- Breakdowns -->
                <div class="mb-3">
                    <label class="form-label small fw-bold mb-1">Breakdowns <span class="text-muted fw-normal">(optional)</span></label>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var area in Model.BreakdownAreaOptions)
                        {
                            var bid = "qb_" + area;
                            <input class="btn-check" type="checkbox" name="QuickBreakdowns" value="@area" id="@bid" autocomplete="off" />
                            <label class="btn btn-outline-danger btn-sm rounded-pill" for="@bid">@area</label>
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-success w-100 fw-bold">Log Session ⚡</button>
            </form>
            <div class="text-center mt-2">
                <a asp-page="/LogSession" class="text-muted small text-decoration-none">📝 Full detailed log →</a>
            </div>
        </div>
    </div>

    <!-- Compact stats row -->
    <div class="d-flex gap-2 mb-3 text-center">
        <div class="flex-fill card shadow-sm">
            <div class="card-body py-2 px-1">
                <div class="fw-bold fs-5 text-danger">@Model.CurrentStreak</div>
                <div class="text-muted small">🔥 Streak</div>
            </div>
        </div>
        <div class="flex-fill card shadow-sm">
            <div class="card-body py-2 px-1">
                <div class="fw-bold fs-5">@Model.ThisWeekCount<span class="text-muted fw-normal">/@Model.WeeklyGoal</span></div>
                <div class="text-muted small">📅 This Week</div>
            </div>
        </div>
        <div class="flex-fill card shadow-sm">
            <div class="card-body py-2 px-1">
                <div class="fw-bold fs-5 text-primary">@Model.TotalSessions</div>
                <div class="text-muted small">📊 Total</div>
            </div>
        </div>
        <div class="flex-fill card shadow-sm">
            <div class="card-body py-2 px-1">
                <div class="fw-bold fs-5 text-warning">@Model.AvgEnergy.ToString("F0")</div>
                <div class="text-muted small">⚡ Energy</div>
            </div>
        </div>
    </div>

    <!-- Collapsible: Recent Sessions + Trends -->
    <div class="mb-3">
        <a class="text-decoration-none text-muted d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#recentSection" role="button">
            <span class="fw-bold small">🕐 Recent Sessions</span>
            <span class="small">▾</span>
        </a>
        <div class="collapse mt-2" id="recentSection">
            @foreach (var s in Model.RecentSessions)
            {
                <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                    <div>
                        <span class="fw-bold small">@s.Date.ToString("MMM dd")</span>
                        <span class="text-muted small">@s.DurationMinutes min</span>
                        @if (s.SessionRating is >= 1 and <= 5)
                        {
                            <span>@ratingEmojis[s.SessionRating.Value]</span>
                        }
                    </div>
                    <div>
                        <span class="badge @(s.EnergyLevel >= 7 ? "bg-success" : s.EnergyLevel >= 4 ? "bg-warning text-dark" : "bg-danger") small">⚡@s.EnergyLevel</span>
                        @if (!string.IsNullOrEmpty(s.BreakdownAreas))
                        {
                            <span class="text-muted small ms-1">@s.BreakdownAreas</span>
                        }
                    </div>
                </div>
            }
            <a asp-page="/History" class="small text-decoration-none d-block mt-2">View all history →</a>
        </div>
    </div>

    <!-- Collapsible: Trends Chart -->
    <div class="mb-4">
        <a class="text-decoration-none text-muted d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#trendsSection" role="button">
            <span class="fw-bold small">📈 Energy Trends</span>
            <span class="small">▾</span>
        </a>
        <div class="collapse mt-2" id="trendsSection">
            <canvas id="trendsChart" height="180"></canvas>
        </div>
    </div>
}

@if (Model.TotalSessions > 0)
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        // Only init chart when the collapse opens (lazy)
        var chartInitialized = false;
        document.getElementById('trendsSection')?.addEventListener('shown.bs.collapse', function() {
            if (chartInitialized) return;
            chartInitialized = true;
            new Chart(document.getElementById('trendsChart'), {
                type: 'line',
                data: {
                    labels: @Html.Raw(Model.ChartLabels),
                    datasets: [{
                        label: 'Energy',
                        data: @Html.Raw(Model.ChartEnergy),
                        borderColor: '#ffc107',
                        backgroundColor: 'rgba(255,193,7,0.1)',
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { min: 0, max: 10, ticks: { stepSize: 2 } } }
                }
            });
        });

        // Quick duration buttons
        document.querySelectorAll('.quick-dur').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.quick-dur').forEach(function(b) {
                    b.classList.remove('btn-success', 'active');
                    b.classList.add('btn-outline-secondary');
                });
                this.classList.remove('btn-outline-secondary');
                this.classList.add('btn-success', 'active');
                document.getElementById('quickDuration').value = this.getAttribute('data-val');
            });
        });
    </script>
}

<!-- Post-log debrief fetch -->
@if (TempData["ShowDebrief"] != null)
{
    <script>
        (async function() {
            try {
                var res = await fetch('/LogSession?handler=Insight');
                var data = await res.json();
                document.getElementById('debriefSpinner').style.display = 'none';
                document.getElementById('debriefLoading').style.display = 'none';
                var content = document.getElementById('debriefContent');
                content.innerHTML = '<div class="small"><strong>🤖 Quick insight:</strong> ' + data.tip + '</div>';
                content.style.display = 'block';
            } catch {
                document.getElementById('debriefCard')?.remove();
            }
        })();
    </script>
}
